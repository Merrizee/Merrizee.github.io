        <!-- ===== ReflectiveFeign ===== -->
        <mxCell id="rfeign" value="ReflectiveFeign.newInstance(target)&#xa;JDK 动态代理 → 生成接口实现代理对象并注入 Spring 容器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=1;" vertex="1" parent="1">
