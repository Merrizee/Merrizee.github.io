        <mxCell id="smh_4" value="④ Client.execute(request, options)  发送 HTTP 请求" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;align=left;" vertex="1" parent="smh">
          <mxGeometry x="10" y="104" width="520" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="smh_5" value="⑤ Decoder.decode(response) / ErrorDecoder 处理非 2xx" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;align=left;" vertex="1" parent="smh">
