        <!-- ===== SynchronousMethodHandler ===== -->
        <mxCell id="smh" value="SynchronousMethodHandler" style="swimlane;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;startSize=28;horizontal=1;" vertex="1" parent="1">
          <mxGeometry x="370" y="1435" width="540" height="162" as="geometry"/>
        </mxCell>
        <mxCell id="smh_1" value="① 构建 RequestTemplate  (URL / Header / Body 模板)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;align=left;" vertex="1" parent="smh">
          <mxGeometry x="10" y="35" width="520" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="smh_2" value="② 遍历 List&lt;RequestInterceptor&gt;.apply(template)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;align=left;" vertex="1" parent="smh">
          <mxGeometry x="10" y="58" width="520" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="smh_3" value="③ Encoder.encode()  序列化请求体" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;align=left;" vertex="1" parent="smh">
