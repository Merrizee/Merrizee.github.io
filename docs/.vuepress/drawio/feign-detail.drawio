        <!-- ===== Retry box ===== -->
        <mxCell id="retry_note" value="Retryer.continueOrPropagate()&#xa;异常时按策略重试" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=9;" vertex="1" parent="1">
