// ==============================
// 首页 Hero Banner
// ==============================
.home-wrapper .banner
  min-height: 360px !important

.home-wrapper .banner .banner-conent .hero
  margin-top: 2.5rem !important

.home-wrapper .banner .banner-conent .hero img
  width: 112px !important
  height: 112px !important
  max-height: 112px !important
  margin: 0 auto 1.2rem !important
  animation: none !important
  filter: drop-shadow(0 6px 18px rgba(217,119,87,0.22)) !important

.home-wrapper .banner .banner-conent .hero h1
  display: none !important

.home-wrapper .banner .banner-conent .hero .description
  font-size: 1rem !important
  color: #71717a !important
  opacity: 1 !important

// ==============================
// 首页 Feature 卡片
// ==============================
.home-wrapper .banner .banner-conent .features
  margin-top: 1.5rem !important
  padding: 1rem 0 2.5rem !important
  gap: 1rem !important
  display: flex !important
  flex-wrap: wrap !important
  justify-content: space-between !important

.home-wrapper .banner .banner-conent .feature
  background: #ffffff !important
  border: 1px solid #e4e4e7 !important
  border-radius: 10px !important
  box-shadow: 0 1px 4px rgba(0,0,0,0.05) !important
  transition: all 0.2s ease !important
  flex-basis: 30% !important
  max-width: 30% !important

.theme-mode-dark .home-wrapper .banner .banner-conent .feature
  background: #18181b !important
  border-color: #27272a !important

.home-wrapper .banner .banner-conent .feature:hover
  border-color: #D97757 !important
  box-shadow: 0 4px 18px rgba(217,119,87,0.15) !important
  transform: translateY(-3px) !important

.home-wrapper .banner .banner-conent .feature a
  display: block !important
  padding: 1.6rem 1.4rem !important
  color: var(--textColor) !important

.home-wrapper .banner .banner-conent .feature a h2
  font-size: 1.05rem !important
  font-weight: 600 !important
  border-bottom: none !important
  padding-bottom: 0.4rem !important
  color: var(--textColor) !important
  border-left: 3px solid #D97757 !important
  padding-left: 0.6rem !important
  margin-bottom: 0.6rem !important

.home-wrapper .banner .banner-conent .feature a p
  font-size: 0.875rem !important
  line-height: 1.6 !important
  color: #71717a !important
  opacity: 1 !important

.home-wrapper .banner .banner-conent .feature:hover a h2
  color: #D97757 !important

.home-wrapper .banner .banner-conent .feature:hover a p
  color: #52525b !important

.theme-mode-dark .home-wrapper .banner .banner-conent .feature a p
  color: #a1a1aa !important

// ==============================
// 首页布局：侧边栏左侧，内容右侧
// ==============================
.home-wrapper .main-wrapper .main-left
  order: 2 !important

.home-wrapper .main-wrapper .main-right
  order: 1 !important
  position: sticky !important
  top: 4.2rem !important
  align-self: flex-start !important
  max-height: calc(100vh - 5rem) !important
  overflow-y: auto !important
  scrollbar-width: none !important

.home-wrapper .main-wrapper .main-right::-webkit-scrollbar
  display: none !important

.home-wrapper .main-wrapper .main-right .card-box
  margin: 0 0.8rem 0.8rem 0 !important
  padding-top: 0.7rem !important
  padding-bottom: 0.7rem !important

.blogger-wrapper .avatar img
  max-height: 180px !important
  object-fit: cover !important

.categories-wrapper .categories a
  padding-top: 6px !important
  padding-bottom: 6px !important

.tags-wrapper .tags a
  margin: 3px !important

.home-wrapper .main-wrapper
  margin-top: 1rem !important

// ==============================
// 导航栏 - shareai.run 风格
// ==============================
.theme-vdoing .navbar
  background: rgba(255,255,255,.92) !important
  backdrop-filter: blur(12px) !important
  -webkit-backdrop-filter: blur(12px) !important
  border-bottom: 1px solid #e4e4e7 !important
  box-shadow: none !important
  height: 3.6rem !important

.theme-mode-dark .navbar
  background: rgba(9,9,11,.92) !important
  border-bottom-color: #27272a !important

.theme-vdoing .navbar .site-name
  font-weight: 700 !important
  color: #09090b !important
  letter-spacing: -0.01em !important

.theme-mode-dark .navbar .site-name
  color: #fafafa !important

.theme-vdoing .navbar .nav-item > .nav-link
  color: #52525b !important
  font-size: 0.9rem !important
  font-weight: 500 !important
  transition: color 0.15s ease !important

.theme-vdoing .navbar .nav-item > .nav-link:hover
  color: #09090b !important

.theme-mode-dark .theme-vdoing .navbar .nav-item > .nav-link
  color: #a1a1aa !important

.theme-mode-dark .theme-vdoing .navbar .nav-item > .nav-link:hover
  color: #fafafa !important

// ==============================
// 博主信息卡片
// ==============================
.home-wrapper .blogger-wrapper
  background: #ffffff !important
  border: 1px solid #e4e4e7 !important
  border-radius: 10px !important
  overflow: hidden !important

.theme-mode-dark .home-wrapper .blogger-wrapper
  background: #18181b !important
  border-color: #27272a !important

.home-wrapper .blogger-wrapper .blogger-info .blogger-name
  font-weight: 700 !important
  font-size: 1.05rem !important
  color: #09090b !important

.theme-mode-dark .home-wrapper .blogger-wrapper .blogger-info .blogger-name
  color: #fafafa !important

.home-wrapper .blogger-wrapper .blogger-info .blogger-slogan
  color: #71717a !important
  font-size: 0.875rem !important

// ==============================
// 首页侧边栏卡片通用
// ==============================
.home-wrapper .card-box
  background: #ffffff !important
  border: 1px solid #e4e4e7 !important
  border-radius: 10px !important

.theme-mode-dark .home-wrapper .card-box
  background: #18181b !important
  border-color: #27272a !important

// ==============================
// 文章列表卡片
// ==============================
.theme-vdoing .card-list .content-wrapper
  border-radius: 8px !important
  border: 1px solid #e4e4e7 !important
  box-shadow: none !important
  transition: border-color 0.15s ease, box-shadow 0.15s ease !important
  background: #ffffff !important

.theme-mode-dark .theme-vdoing .card-list .content-wrapper
  border-color: #27272a !important
  background: #18181b !important

.theme-vdoing .card-list .content-wrapper:hover
  border-color: #D97757 !important
  box-shadow: 0 2px 12px rgba(217,119,87,0.1) !important
  transform: none !important

// ==============================
// 侧边栏（文章页）
// ==============================
.theme-vdoing .sidebar
  background: #ffffff !important
  border-right: 1px solid #e4e4e7 !important

.theme-mode-dark .theme-vdoing .sidebar
  background: #09090b !important
  border-right-color: #27272a !important

.theme-vdoing .sidebar .sidebar-link.active
  color: #D97757 !important
  font-weight: 600 !important

// ==============================
// 文章正文区域
// ==============================
.theme-vdoing-content a
  color: #D97757 !important

.theme-vdoing-content a:hover
  color: #C2623E !important

.theme-vdoing-content h2
  border-bottom: 1px solid #e4e4e7 !important
  padding-bottom: 0.4rem !important

.theme-mode-dark .theme-vdoing-content h2
  border-bottom-color: #27272a !important

// ==============================
// 评论区
// ==============================
.gt-container
  .gt-ico-tip
    &::after
      content: '。( Win + . ) 或 ( ⌃ + ⌘ + ␣ ) 打开表情'
      color: #a1a1aa
      font-size: .8rem
  .gt-meta
    border-color var(--borderColor)!important
  .gt-comments-null
    color var(--textColor)
    opacity .5
  .gt-header-textarea
    color var(--textColor)
    background rgba(180,180,180,0.08)!important
    border-color: #e4e4e7 !important
  .gt-btn
    border-color $accentColor!important
    background-color $accentColor!important
  .gt-btn-preview
    background-color rgba(255,255,255,0)!important
    color $accentColor!important
  a
    color $accentColor!important
  .gt-svg svg
    fill $accentColor!important
  .gt-comment-content,.gt-comment-admin .gt-comment-content
    background-color rgba(150,150,150,0.08)!important
    border: 1px solid #e4e4e7 !important
    border-radius: 8px !important
    &:hover
      box-shadow 0 0 20px rgba(150,150,150,.3)!important
    .gt-comment-body
      color var(--textColor)!important

// ==============================
// Demo 代码块
// ==============================
body .vuepress-plugin-demo-block__wrapper
  &,.vuepress-plugin-demo-block__display
    border-color rgba(228,228,231,.8)
  .vuepress-plugin-demo-block__footer:hover
    .vuepress-plugin-demo-block__expand::before
      border-top-color: $accentColor !important;
      border-bottom-color: $accentColor !important;
    svg
      fill: $accentColor !important;

// ==============================
// 搜索框
// ==============================
.suggestions
  overflow: auto
  max-height: calc(100vh - 6rem)
  border: 1px solid #e4e4e7 !important
  border-radius: 8px !important
  box-shadow: 0 4px 20px rgba(0,0,0,0.08) !important
  @media (max-width: 719px) {
    width: 90vw;
    min-width: 90vw!important;
    margin-right: -20px;
  }
  .highlight
    color: $accentColor
    font-weight: bold

// ==============================
// 代码块
// ==============================
div[class*="language-"]
  border-radius: 8px !important
  border: 1px solid #e4e4e7 !important

.theme-mode-dark div[class*="language-"]
  border-color: #27272a !important

// ==============================
// 标签 & 分类页
// ==============================
.tags-wrapper .tags a
  border: 1px solid #e4e4e7 !important
  border-radius: 6px !important
  background: #fafafa !important
  color: #52525b !important
  transition: all 0.15s ease !important

.tags-wrapper .tags a:hover
  border-color: #D97757 !important
  color: #D97757 !important
  background: #fff7ed !important

.theme-mode-dark .tags-wrapper .tags a
  background: #18181b !important
  border-color: #27272a !important
  color: #a1a1aa !important
